# API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM Configuration
# These are used for all nodes unless overridden
LLM_PROVIDER=openai
LLM_MODEL=gpt-5

# Per-Node LLM Configuration (Optional)
# Format: NODENAME_PROVIDER and NODENAME_MODEL
# Uncomment and customize as needed:

# IDEA_DIVERGENCE_MODEL=gpt-4o
# DIVERSITY_ENFORCER_MODEL=gpt-4o-mini
# ANTI_AI_FILTER_MODEL=gpt-4o
# CONSTRAINT_INJECTOR_MODEL=gpt-4o
# SCENARIO_TRANSFORMER_MODEL=gpt-4o
# ADVERSARIAL_AGENT_MODEL=gpt-4o
# ADVERSARIAL_AGENT_PROVIDER=anthropic
# PATCH_NODE_MODEL=gpt-4o
# EVALUATION_DESIGNER_MODEL=gpt-4o
# SELF_CRITIQUE_MODEL=gpt-4o
# PRD_GENERATOR_MODEL=gpt-4o


# Tracing - Optional, but recommended for debugging and performance monitoring in development
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=<your-api-key>
# LANGSMITH_PROJECT="PRDinator"